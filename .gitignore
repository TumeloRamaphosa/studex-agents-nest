# --- CREDENTIAL FILES ---
# This repo's remote is PUBLIC. These files hold live API keys and must never
# be committed, or a push publishes working credentials to the world.
# 2026-10-23: the AgentMail GENERAL key was found hardcoded in two live
# landing-page JS bundles. Rotating it was not enough - the fix was to keep
# credentials out of anything that can be served or pushed.
.env
.env.*
!.env.example
*.env
!.env.production.local
TOOLS.md
TOOLS_SUPPLEMENT.md
studex-os/.vscode/*.env
studex-os/*.env
studex-workflows/.env
# A nested .gitignore in core/packages/database/ has `!.env`, which un-ignores
# a REAL credential file and puts it back in `git add .` scope. Guard it here.
core/packages/database/.env
matrix-chat-history/
.matrix-chat-history/

# Credential-scrubbing tools. They contain live credentials by design
# (a scrubber needs the list of secrets it is removing), so they must
# never be tracked - the repo's remote is PUBLIC.
scripts/scrub-tracked-credentials.py
scripts/fix-ciii-env-loader.py

# mcporter-generated MCP wrapper. It embeds the MCP server's auth
# header, so it must not be committed. Regenerate with mcporter.
blotato.ts

# VS Code MCP server definitions carry the server's auth token in an
# "env" block. It is a local secret: the working copy stays on disk, but
# the PUBLIC repo must not carry the token. Configure it with mcporter.
studex-os/.vscode/casey-clickup-mcp.json

# One-shot credential migration scripts. They were applied on 2026-10-23;
# they contained live credential literals and ${...} search anchors, so they
# are NOT part of the source of truth. The checker enforces the end state.
_migrate_credentials*.py

