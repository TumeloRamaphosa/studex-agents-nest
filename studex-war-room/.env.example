# ClickUp Integration — War Room
# Get your API token: app.clickup.com/{WORKSPACE_ID}/settings/apps

VITE_CLICKUP_TOKEN=pk_your_token_here
VITE_CLICKUP_WORKSPACE=90152650899

# Get List IDs from the URL when viewing a List:
# https://app.clickup.com/{WORKSPACE_ID}/v/l/{LIST_ID}
# Copy the list ID from each URL

VITE_CLICKUP_LIST_COFFEE=your_coffee_list_id_here
VITE_CLICKUP_LIST_CAVIAR=your_caviar_list_id_here
VITE_CLICKUP_LIST_BILTONG=your_biltong_list_id_here
